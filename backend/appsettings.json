{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Security": {
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080"
    ],
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "BlockedIps": [],
    "RequestsPerMinute": 60,
    "EnquiryCooldownSeconds": 15,
    "MaxRequestBodyBytes": 8192,
    "AdminMaxFailedAttempts": 5,
    "MaxProbeStrikes": 3,
    "BanMinutes": 15,
    "MinimumAdminKeyLength": 24
  },
  "Data": {
    "RetentionDays": 180,
    "BackupIntervalHours": 24,
    "BackupsToKeep": 14
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "UseStartTls": true,
    "SmtpUsername": "",
    "From": "",
    "ManagerAddress": "",
    "ManagerPageUrl": "",
    "TimeZone": "Australia/Hobart"
  }
}
